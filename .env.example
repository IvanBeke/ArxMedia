# === ArxMedia - Docker Compose environment ===
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
TIME_ZONE=Europe/Madrid
ALLOWED_HOSTS=localhost,127.0.0.1,app
CORS_ALLOWED_ORIGINS=http://localhost

# TMDB  (required — get a free key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key-here

# Django + Vite integration (dev mode serves from Vite server)
DJANGO_VITE_DEV_MODE=False
DJANGO_VITE_DEV_SERVER_PROTOCOL=http
DJANGO_VITE_DEV_SERVER_HOST=localhost
DJANGO_VITE_DEV_SERVER_PORT=5173

# Encryption key for sensitive DB fields (Fernet, 32-byte urlsafe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-fernet-key

# PostgreSQL
POSTGRES_DB=arxmedia
POSTGRES_USER=arxmedia
POSTGRES_PASSWORD=change-me-db-password
# Set DATABASE_URL for PostgreSQL deployments; leave empty to use SQLite in local dev
DATABASE_URL=postgres://arxmedia:change-me-db-password@db:5432/arxmedia

# Port exposed on the host (default 80)
PORT=80

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1
